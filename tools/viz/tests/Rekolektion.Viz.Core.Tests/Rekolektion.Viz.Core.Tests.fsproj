  <ItemGroup>
    <Content Include="..\..\testdata\bitcell_lr.gds">
      <Link>testdata\bitcell_lr.gds</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\testdata\bitcell_lr.nets.json">
